vetor = []
print("Preencha o vetor de 8 posições:")
for i in range(8):
    vetor.append(int(input(f"Valor {i}: ")))

x = int(input("Digite a posição X (entre 0 e 7): "))
y = int(input("Digite a posição Y (entre 0 e 7): "))

soma = vetor[x] + vetor[y]
print(f"A soma dos valores nas posições {x} e {y} é: {soma}")